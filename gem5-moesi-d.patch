+  // The 53 transient states in which the base protocol parks an L1_GETX with
+  // st_stallAndWaitL1RequestQueue instead of acting on it. With d_state_busy_stall
+  // a delegated request in these states waits the same way and is woken by the
+  // same wakeUpAllBuffers(address) calls, so it inherits the base protocol's
+  // liveness argument; without the knob these states are not owner_ok and reject.
+  // Measured motivation: under read-interleaving 3,623 of 3,625 rejections came
+  // from IFLOXX alone, leaving 2 of 8,000 updates delegated.
+  bool dstateBaseStalls(State st) {
+    return (st == State:IFGS || st == State:IFGX || st == State:IFGXX || st == State:IFGXXD ||
+            st == State:IFLO || st == State:IFLOSX || st == State:IFLOX || st == State:IFLOXX ||
+            st == State:IFLS || st == State:IFLXO || st == State:IGM || st == State:IGMIO ||
+            st == State:IGMIOF || st == State:IGMIOFD || st == State:IGMIOFS || st == State:IGMLS ||
+            st == State:IGMO || st == State:IGMOU || st == State:IGS || st == State:II ||
+            st == State:ILOD || st == State:ILOSD || st == State:ILOSW || st == State:ILOSXD ||
+            st == State:ILOSXW || st == State:ILOW || st == State:ILOXD || st == State:ILOXW ||
+            st == State:ILSI || st == State:ILSW || st == State:ILXD || st == State:ILXW ||
+            st == State:ISFGS || st == State:IW || st == State:MI || st == State:MII ||
+            st == State:MM || st == State:OGMIO || st == State:OGMIOF || st == State:OI ||
+            st == State:OLSF || st == State:OLSI || st == State:OLSS || st == State:OLSW ||
+            st == State:OLSXS || st == State:OLSXW || st == State:OO || st == State:OW ||
+            st == State:OXW || st == State:SLSS || st == State:SLSW || st == State:SS ||
+            st == State:SW);
+  }
