+   bool d_state_enabled := "True";
+   // With the line held read-only (S), delegate the update anyway and drop the
+   // read copy, instead of upgrading to exclusive (a migration). The home bank
+   // invalidates the stale sharer bit before applying; a NACK falls back to the
+   // ordinary GETX path as usual. Default off.
+   bool d_state_delegate_from_s := "False";
+
+   // Message Queues
+   // From this node's L1 cache TO the network
+   // a local L1 -> this L2 bank, currently ordered with directory forwarded requests
+   MessageBuffer * requestFromL1Cache, network="To", virtual_network="0",
+        vnet_type="request";
+   // a local L1 -> this L2 bank
+   MessageBuffer * responseFromL1Cache, network="To", virtual_network="2",
+        vnet_type="response";
+
+   // To this node's L1 cache FROM the network
+   // a L2 bank -> this L1
+   MessageBuffer * requestToL1Cache, network="From", virtual_network="0",
+        vnet_type="request";
+   // a L2 bank -> this L1
