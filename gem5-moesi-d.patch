+          out_msg.DataBlk := tbe.DataBlk;
+          // out_msg.Dirty := tbe.Dirty;
+          out_msg.Dirty := false;
+          out_msg.Acks := in_msg.Acks;
+          out_msg.MessageSize := MessageSizeType:ResponseLocal_Data;
+        }
+      }
+      else {
+        enqueue(responseNetwork_out, ResponseMsg, response_latency) {
+          out_msg.addr := address;
+          out_msg.Type := CoherenceResponseType:DATA;
+          out_msg.Sender := machineID;
+          out_msg.SenderMachine := MachineType:L1Cache;
+          out_msg.Destination.add(mapAddressToMachine(address,
+                                                      MachineType:L2Cache));
+          out_msg.DataBlk := tbe.DataBlk;
+          // out_msg.Dirty := tbe.Dirty;
+          out_msg.Dirty := false;
+          out_msg.Acks := in_msg.Acks;
+          out_msg.MessageSize := MessageSizeType:Response_Data;
+        }
+      }
+    }
+  }
+
+  action(q_sendExclusiveDataFromTBEToCache, "qq", desc="Send data from TBE to cache") {
+    peek(requestNetwork_in, RequestMsg) {
+      assert(is_valid(tbe));
+      if (in_msg.RequestorMachine == MachineType:L1Cache) {
+        enqueue(responseNetwork_out, ResponseMsg, response_latency) {
+          out_msg.addr := address;
+          out_msg.Type := CoherenceResponseType:DATA_EXCLUSIVE;
+          out_msg.Sender := machineID;
+          out_msg.SenderMachine := MachineType:L1Cache;
+          out_msg.Destination.add(in_msg.Requestor);
+          out_msg.DataBlk := tbe.DataBlk;
+          out_msg.Dirty := tbe.Dirty;
+          out_msg.Acks := in_msg.Acks;
+          out_msg.MessageSize := MessageSizeType:ResponseLocal_Data;
+        }
+      }
+      else {
+        enqueue(responseNetwork_out, ResponseMsg, response_latency) {
+          out_msg.addr := address;
+          out_msg.Type := CoherenceResponseType:DATA_EXCLUSIVE;
+          out_msg.Sender := machineID;
+          out_msg.SenderMachine := MachineType:L1Cache;
+          out_msg.Destination.add(mapAddressToMachine(address,
+                                                      MachineType:L2Cache));
+          out_msg.DataBlk := tbe.DataBlk;
+          out_msg.Dirty := tbe.Dirty;
+          out_msg.Acks := in_msg.Acks;
+          out_msg.MessageSize := MessageSizeType:Response_Data;
+        }
+      }
+    }
+  }
+
+  // L2 will usually request data for a writeback
+  action(qq_sendWBDataFromTBEToL2, "\q", desc="Send data from TBE to L2") {
+    enqueue(requestNetwork_out, RequestMsg, request_latency) {
+      assert(is_valid(tbe));
+      out_msg.addr := address;
+      out_msg.Requestor := machineID;
+      out_msg.RequestorMachine := MachineType:L1Cache;
+      out_msg.Destination.add(mapAddressToMachine(address,
+                                                  MachineType:L2Cache));
+      if (tbe.Dirty) {
+        out_msg.Type := CoherenceRequestType:WRITEBACK_DIRTY_DATA;
+      } else {
+        out_msg.Type := CoherenceRequestType:WRITEBACK_CLEAN_DATA;
+      }
+      out_msg.DataBlk := tbe.DataBlk;
+      out_msg.MessageSize := MessageSizeType:Writeback_Data;
+    }
+  }
+
+  action(s_deallocateTBE, "s", desc="Deallocate TBE") {
+    TBEs.deallocate(address);
+    unset_tbe();
+  }
+
+  action(u_writeDataToCache, "u", desc="Write data to cache") {
+    peek(responseToL1Cache_in, ResponseMsg) {
+      assert(is_valid(cache_entry));
+      cache_entry.DataBlk := in_msg.DataBlk;
+      cache_entry.Dirty := in_msg.Dirty;
+
+      if (in_msg.Type == CoherenceResponseType:DATA) {
+        //assert(in_msg.Dirty == false);
+      }
+    }
+  }
+
+  action(kk_deallocateL1CacheBlock, "\k", desc="Deallocate cache block.  Sets the cache to invalid, allowing a replacement in parallel with a fetch.") {
+    if (L1Dcache.isTagPresent(address)) {
+      L1Dcache.deallocate(address);
+    } else {
+      L1Icache.deallocate(address);
+    }
+    unset_cache_entry();
+  }
+
+  action(ii_allocateL1DCacheBlock, "\i", desc="Set L1 D-cache tag equal to tag of block B.") {
+    if ((is_invalid(cache_entry))) {
+      set_cache_entry(L1Dcache.allocate(address, new Entry));
+    }
+  }
+
+  action(jj_allocateL1ICacheBlock, "\j", desc="Set L1 I-cache tag equal to tag of block B.") {
+    if ((is_invalid(cache_entry))) {
+      set_cache_entry(L1Icache.allocate(address, new Entry));
+    }
+  }
+
+  action(forward_eviction_to_cpu, "\cc", desc="sends eviction information to the processor") {
+    if (send_evictions) {
+      DPRINTF(RubySlicc, "Sending invalidation for %#x to the CPU\n", address);
+      sequencer.evictionCallback(address);
+    }
+  }
+
+  action(uu_profileInstMiss, "\uim", desc="Profile the demand miss") {
+    L1Icache.profileDemandMiss();
+  }
+
+  action(uu_profileInstHit, "\uih", desc="Profile the demand hit") {
+    L1Icache.profileDemandHit();
+  }
+
+  action(uu_profileDataMiss, "\udm", desc="Profile the demand miss") {
+    L1Dcache.profileDemandMiss();
+  }
+
+  action(uu_profileDataHit, "\udh", desc="Profile the demand hit") {
+    L1Dcache.profileDemandHit();
+  }
+
+  action(z_recycleRequestQueue, "z", desc="Send the head of the mandatory queue to the back of the queue.") {
+    requestNetwork_in.recycle(clockEdge(), cyclesToTicks(recycle_latency));
+  }
+
+  action(zz_recycleMandatoryQueue, "\z", desc="Send the head of the mandatory queue to the back of the queue.") {
+    mandatoryQueue_in.recycle(clockEdge(), cyclesToTicks(recycle_latency));
+  }
+
+
+  action(d_amoComplete, "amoc", desc="Apply AMO functor to exclusive line and complete (atomicCallback)") {
+    assert(is_valid(cache_entry));
+    sequencer.atomicCallback(address, cache_entry.DataBlk);
+    cache_entry.Dirty := true;
+  }
+
+
+  action(i_allocateTBE_dstate, "iTd", desc="Allocate TBE for delegated D_REQ") {
+    check_allocate(TBEs);
+    TBEs.allocate(address);
+    set_tbe(TBEs[address]);
+    assert(is_valid(cache_entry));
+    tbe.DataBlk := cache_entry.DataBlk;
+    tbe.Dirty := false;
+    tbe.DStateId := dStateRequests.nextId();
+    peek(mandatoryQueue_in, RubyRequest) {
+      tbe.DStateAccessMode := in_msg.AccessMode;
+      tbe.DStatePrefetch := in_msg.Prefetch;
+    }
+  }
+
+  action(idsr_issueDStateReqFromL1, "idsr", desc="Delegate ATOMIC_NO_RETURN to home L2") {
+    peek(mandatoryQueue_in, RubyRequest) {
+      enqueue(requestNetwork_out, RequestMsg, request_latency) {
+        out_msg.addr := address;
+        out_msg.Type := CoherenceRequestType:DSTATE_REQ;
+        out_msg.DStateId := tbe.DStateId;
+        out_msg.Requestor := machineID;
+        out_msg.RequestorMachine := MachineType:L1Cache;
+        out_msg.Destination.add(mapAddressToMachine(address, MachineType:L2Cache));
+        // Size class follows the operand width; byte budgets are derived in
+        // RubySlicc_Exports.sm next to the MessageSizeType entries.
+        if (in_msg.DStateWords > 1) {
+          // Delta line: the sequencer combined adds to several words of this
+          // line (DSTATE_REQ_COMBINE / dstate_delta_min_words); masks say which.
+          out_msg.DStateOp := DStateOpType:IADD_LINE;
+          if (in_msg.DStateWords <= 4) {
+            out_msg.MessageSize := MessageSizeType:DState_UpdateW4;
+          } else if (in_msg.DStateWords <= 8) {
+            out_msg.MessageSize := MessageSizeType:DState_UpdateW8;
+          } else if (in_msg.DStateWords <= 16) {
+            out_msg.MessageSize := MessageSizeType:DState_UpdateW16;
+          } else {
+            out_msg.MessageSize := MessageSizeType:DState_UpdateW32;
+          }
+        } else if (in_msg.Size == 8) {
+          out_msg.DStateOp := DStateOpType:IADD64;
+          out_msg.MessageSize := MessageSizeType:DState_Update64;
+        } else {
+          out_msg.DStateOp := DStateOpType:IADD32;
+          out_msg.MessageSize := MessageSizeType:DState_Update;
+        }
+        out_msg.Len := in_msg.Size;
+        out_msg.DStateOffset := getOffset(in_msg.PhysicalAddress);
+        out_msg.DStateMask32 := in_msg.DStateMask32;
+        out_msg.DStateMask64 := in_msg.DStateMask64;
+        out_msg.DataBlk := in_msg.WTData;
+      }
+    }
+  }
+
+  action(camo_completeDelegated, "camo", desc="Complete an already-applied remote atomic without executing it twice") {
+    peek(responseToL1Cache_in, ResponseMsg) {
+      // With d_state_ack_value the ACK carries the updated word; the sequencer
+      // completes a load of that word waiting behind the add from it.
+      DataBlock value := in_msg.DataBlk;
+      sequencer.atomicRemoteCallback(address, value, in_msg.HasValue);
+    }
+  }
+
+  action(d_checkResponseId, "dcheckid", desc="Reject stale or mismatched terminal responses") {
+    peek(responseToL1Cache_in, ResponseMsg) {
+      assert(is_valid(tbe));
+      assert(in_msg.DStateId == tbe.DStateId);
+      assert(in_msg.Sender == mapAddressToMachine(address, MachineType:L2Cache));
+    }
+  }
+
+  action(d_scheduleFallback, "dsched", desc="Consume NACK independently of request-network availability") {
+    dRetryTimer.set(address, clockEdge() + cyclesToTicks(request_latency));
+  }
+  action(d_cancelFallbackTimer, "dcancel", desc="Fallback request has been enqueued") {
+    dRetryTimer.unset(address);
+  }
+
+  action(b_issueDStateFallbackGETX, "dfgx", desc="Retry rejected, still-pending atomic through normal ownership acquisition") {
+    assert(is_valid(tbe));
+    enqueue(requestNetwork_out, RequestMsg, request_latency) {
+      out_msg.addr := address;
+      out_msg.Type := CoherenceRequestType:GETX;
+      out_msg.Requestor := machineID;
+      out_msg.RequestorMachine := MachineType:L1Cache;
+      out_msg.Destination.add(mapAddressToMachine(address, MachineType:L2Cache));
+      out_msg.MessageSize := MessageSizeType:Request_Control;
+      out_msg.AccessMode := tbe.DStateAccessMode;
+      out_msg.Prefetch := tbe.DStatePrefetch;
+    }
+  }
+
+  //*****************************************************
+  // TRANSITIONS
+  //*****************************************************
+
+  // Transitions for Load/Store/L2_Replacement from transient states
+  transition({IM, SM, OM, IS, OI, SI, MI, II}, {Store, L1_Replacement}) {
+    zz_recycleMandatoryQueue;
+  }
+
+  transition({M_W, MM_W}, L1_Replacement) {
+    zz_recycleMandatoryQueue;
+  }
+
+  transition({M_W, MM_W}, {Fwd_GETS, Fwd_DMA, Fwd_GETX, Own_GETX, Inv}) {
+    z_recycleRequestQueue;
+  }
+
+  transition({IM, IS, OI, MI, SI, II, D_REQ, D_RETRY, D_REQ_S, D_RETRY_S}, {Load, Ifetch}) {
+    // D_REQ retains the CPU operation. Loads wait for remote completion or
+    // completion of the conventional GETX fallback after a rejection.
+    zz_recycleMandatoryQueue;
+  }
+
+  // Transitions from Idle
+  transition(I, Load, IS) {
+    ii_allocateL1DCacheBlock;
+    i_allocateTBE;
+    a_issueGETS;
+    uu_profileDataMiss;
+    k_popMandatoryQueue;
+  }
+
+  transition(I, Ifetch, IS) {
+    jj_allocateL1ICacheBlock;
+    i_allocateTBE;
+    a_issueGETS;
+    uu_profileInstMiss;
+    k_popMandatoryQueue;
+  }
+
+  transition(I, Store, IM) {
+    ii_allocateL1DCacheBlock;
+    i_allocateTBE;
+    b_issueGETX;
+    uu_profileDataMiss;
+    k_popMandatoryQueue;
+  }
+
+  transition(I, L1_Replacement) {
+    kk_deallocateL1CacheBlock;
+  }
+
+  transition(I, Inv) {
+    f_sendAck;
+    l_popForwardQueue;
+  }
+
+  transition({S, SM, O, OM, MM, MM_W, M, M_W}, Load) {
+    h_load_hit;
+    uu_profileDataHit;
+    k_popMandatoryQueue;
+  }
+
+  transition({S, SM, O, OM, MM, MM_W, M, M_W}, Ifetch) {
+    h_ifetch_hit;
+    uu_profileInstHit;
+    k_popMandatoryQueue;
+  }
+
+  // Transitions from Shared
+  transition(S, Store, SM) {
+    i_allocateTBE;
+    b_issueGETX;
+    uu_profileDataMiss;
+    k_popMandatoryQueue;
+  }
+
+  transition(S, L1_Replacement, SI) {
+    i_allocateTBE;
+    dd_issuePUTS;
+    forward_eviction_to_cpu;
+    kk_deallocateL1CacheBlock;
+  }
+
+  transition(S, Inv, I) {
+    f_sendAck;
+    forward_eviction_to_cpu;
+    l_popForwardQueue;
+  }
+
+  transition(S, Fwd_GETS) {
+    e_sendData;
+    l_popForwardQueue;
+  }
+
+  transition(S, Fwd_DMA) {
+    e_sendData;
+    ub_dmaUnblockL2Cache;
+    l_popForwardQueue;
+  }
+
+  // Transitions from Owned
+  transition(O, Store, OM) {
+    i_allocateTBE;
+    b_issueGETX;
+    uu_profileDataMiss;
+    k_popMandatoryQueue;
+  }
+
+  transition(O, L1_Replacement, OI) {
+    i_allocateTBE;
+    dd_issuePUTO;
+    forward_eviction_to_cpu;
+    kk_deallocateL1CacheBlock;
+  }
+
+  transition(O, Fwd_GETX, I) {
+    ee_sendDataExclusive;
+    forward_eviction_to_cpu;
+    l_popForwardQueue;
+  }
+
+  transition(O, Fwd_GETS) {
+    e_sendData;
+    l_popForwardQueue;
+  }
+
+  transition(O, Fwd_DMA) {
+    e_sendData;
+    ub_dmaUnblockL2Cache;
+    l_popForwardQueue;
+  }
+
+  // Transitions from MM
+  transition({MM, MM_W}, Store) {
+    hh_store_hit;
+    uu_profileDataHit;
+    k_popMandatoryQueue;
+  }
+
+  transition(MM, L1_Replacement, MI) {
+    i_allocateTBE;
+    d_issuePUTX;
+    forward_eviction_to_cpu;
+    kk_deallocateL1CacheBlock;
+  }
+
+  transition(MM, Fwd_GETX, I) {
+    ee_sendDataExclusive;
+    forward_eviction_to_cpu;
+    l_popForwardQueue;
+  }
+
+  transition(MM, Fwd_GETS, I) {
+    ee_sendDataExclusive;
+    forward_eviction_to_cpu;
+    l_popForwardQueue;
+  }
+
+  transition(MM, Fwd_DMA, MM) {
+    e_sendData;
+    ub_dmaUnblockL2Cache;
+    l_popForwardQueue;
+  }
+
+  // Transitions from M
+  transition(M, Store, MM) {
+    hh_store_hit;
+    uu_profileDataHit;
+    k_popMandatoryQueue;
+  }
+
+  transition(M_W, Store, MM_W) {
+    hh_store_hit;
+    uu_profileDataHit;
+    k_popMandatoryQueue;
+  }
+
+  transition(M, L1_Replacement, MI) {
+    i_allocateTBE;
+    d_issuePUTX;
+    forward_eviction_to_cpu;
+    kk_deallocateL1CacheBlock;
+  }
+
+  transition(M, Fwd_GETX, I) {
+    // e_sendData;
+    ee_sendDataExclusive;
+    forward_eviction_to_cpu;
+    l_popForwardQueue;
+  }
+
+  transition(M, Fwd_GETS, O) {
+    e_sendData;
+    l_popForwardQueue;
+  }
+
+  transition(M, Fwd_DMA) {
+    e_sendData;
+    ub_dmaUnblockL2Cache;
+    l_popForwardQueue;
+  }
+
+  // Transitions from IM
+
+  transition(IM, Inv) {
+    f_sendAck;
+    l_popForwardQueue;
+  }
+
+  transition(IM, Ack) {
+    m_decrementNumberOfMessages;
+    o_checkForCompletion;
+    n_popResponseQueue;
+  }
+
+  transition(IM, {Exclusive_Data, Data}, OM) {
+    u_writeDataToCache;
+    m_decrementNumberOfMessages;
+    o_checkForCompletion;
+    n_popResponseQueue;
+  }
+
+  // Transitions from SM
+  transition(SM, Inv, IM) {
+    f_sendAck;
+    forward_eviction_to_cpu;
+    l_popForwardQueue;
+  }
+
+  transition(SM, Ack) {
+    m_decrementNumberOfMessages;
+    o_checkForCompletion;
+    n_popResponseQueue;
+  }
+
+  transition(SM, {Data, Exclusive_Data}, OM) {
+    // v_writeDataToCacheVerify;
+    m_decrementNumberOfMessages;
+    o_checkForCompletion;
+    n_popResponseQueue;
+  }
+
+  transition(SM, Fwd_GETS) {
+    e_sendData;
+    l_popForwardQueue;
+  }
+
+  transition(SM, Fwd_DMA) {
+    e_sendData;
+    ub_dmaUnblockL2Cache;
+    l_popForwardQueue;
+  }
+
+  // Transitions from OM
+  transition(OM, Own_GETX) {
+    mm_decrementNumberOfMessages;
+    o_checkForCompletion;
+    l_popForwardQueue;
+  }
+
+
+  // transition(OM, Fwd_GETX, OMF) {
+  transition(OM, Fwd_GETX, IM) {
+    ee_sendDataExclusive;
+    forward_eviction_to_cpu;
+    l_popForwardQueue;
+  }
+
+  transition(OM, Fwd_GETS) {
+    e_sendData;
+    l_popForwardQueue;
+  }
+
+  transition(OM, Fwd_DMA) {
+    e_sendData;
+    ub_dmaUnblockL2Cache;
+    l_popForwardQueue;
+  }
+
+  //transition({OM, OMF}, Ack) {
+  transition(OM, Ack) {
+    m_decrementNumberOfMessages;
+    o_checkForCompletion;
+    n_popResponseQueue;
+  }
+
+  transition(OM, All_acks, MM_W) {
+    xx_store_hit;
+    gg_sendUnblockExclusive;
+    s_deallocateTBE;
+    o_scheduleUseTimeout;
+    j_popTriggerQueue;
+  }
+
+  transition(MM_W, Use_Timeout, MM) {
+    jj_unsetUseTimer;
+  }
+
+  // Transitions from IS
+
+  transition(IS, Inv) {
+    f_sendAck;
+    l_popForwardQueue;
+  }
+
+  transition(IS, Data, S) {
+    u_writeDataToCache;
+    m_decrementNumberOfMessages;
+    hx_load_hit;
+    g_sendUnblock;
+    s_deallocateTBE;
+    n_popResponseQueue;
+  }
+  // Far read: the home answered from a retained line and recorded no sharer, so
+  // nothing is installed, no unblock is owed, and the block goes back to I.
+  transition(IS, Data_Uncached, I) {
+    hu_load_hit_uncached;
+    kk_deallocateL1CacheBlock;
+    s_deallocateTBE;
+    n_popResponseQueue;
+  }
+
+  transition(IS, Exclusive_Data, M_W) {
+    u_writeDataToCache;
+    m_decrementNumberOfMessages;
+    hx_load_hit;
+    gg_sendUnblockExclusive;
+    o_scheduleUseTimeout;
+    s_deallocateTBE;
+    n_popResponseQueue;
+  }
+
+  transition(M_W, Use_Timeout, M) {
+    jj_unsetUseTimer;
+  }
+
+  // Transitions from OI/MI
+
+  transition(MI, Fwd_GETS, OI) {
+    q_sendDataFromTBEToCache;
+    l_popForwardQueue;
+  }
+
+  transition(MI, Fwd_DMA) {
+    q_sendDataFromTBEToCache;
+    ub_dmaUnblockL2Cache;
+    l_popForwardQueue;
+  }
+
+  transition(MI, Fwd_GETX, II) {
+    q_sendExclusiveDataFromTBEToCache;
+    l_popForwardQueue;
+  }
+
+  transition({SI, OI}, Fwd_GETS) {
+    q_sendDataFromTBEToCache;
+    l_popForwardQueue;
+  }
+
+  transition({SI, OI}, Fwd_DMA) {
+    q_sendDataFromTBEToCache;
+    ub_dmaUnblockL2Cache;
+    l_popForwardQueue;
+  }
+
+  transition(OI, Fwd_GETX, II) {
+    q_sendExclusiveDataFromTBEToCache;
+    l_popForwardQueue;
+  }
+
+  transition({SI, OI, MI}, Writeback_Ack_Data, I) {
+    qq_sendWBDataFromTBEToL2;  // always send data
+    s_deallocateTBE;
+    n_popResponseQueue;
+  }
+
+  transition({SI, OI, MI}, Writeback_Ack, I) {
+    g_sendUnblock;
+    s_deallocateTBE;
+    n_popResponseQueue;
+  }
+
+  transition({MI, OI}, Writeback_Nack, OI) {
+    // FIXME: This might cause deadlock by re-using the writeback
+    // channel, we should handle this case differently.
+    dd_issuePUTO;
+    n_popResponseQueue;
+  }
+
+  // Transitions from II
+  transition(II, {Writeback_Ack, Writeback_Ack_Data}, I) {
+    g_sendUnblock;
+    s_deallocateTBE;
+    n_popResponseQueue;
+  }
+
+  // transition({II, SI}, Writeback_Nack, I) {
+  transition(II, Writeback_Nack, I) {
+    s_deallocateTBE;
+    n_popResponseQueue;
+  }
+
+  transition(SI, Writeback_Nack) {
+    dd_issuePUTS;
+    n_popResponseQueue;
+  }
+
+  transition(II, Inv) {
+    f_sendAck;
+    l_popForwardQueue;
+  }
+
+  transition(SI, Inv, II) {
+    f_sendAck;
+    l_popForwardQueue;
+  }
+
+  // ── D-state (delegated ATOMIC_NO_RETURN) transitions ──────────────────────
+  // The sequencer retains the original operation until one terminal completion.
+  // ACK means applied remotely; NACK means not applied and cannot later execute.
+  transition(D_REQ, DState_ACK, I) {
+    d_checkResponseId;
+    camo_completeDelegated;
+    kk_deallocateL1CacheBlock;
+    s_deallocateTBE;
+    n_popResponseQueue;
+  }
+
+  transition(D_REQ, DState_NACK, D_RETRY) {
+    d_checkResponseId;
+    d_scheduleFallback;
+    n_popResponseQueue;
+  }
+
+  transition(D_RETRY, DState_Retry, IM_AMO) {
+    b_issueDStateFallbackGETX;
+    d_cancelFallbackTimer;
+  }
+
+  // Rejection served as a GETX (d_state_reject_as_getx at the home): instead of a
+  // NACK the line arrives exclusive, with the acks the ordinary GETX path counts,
+  // and the retained operation is applied locally on completion (OM_AMO ->
+  // MM_W), exactly as after a fallback GETX. The sequencer applies the front
+  // request's own functor and re-issues any it had combined (atomicCallback).
+  transition(D_REQ, Ack) {
+    m_decrementNumberOfMessages;
+    o_checkForCompletion;
+    n_popResponseQueue;
+  }
+  transition(D_REQ, {Exclusive_Data, Data}, OM_AMO) {
+    u_writeDataToCache;
+    m_decrementNumberOfMessages;
+    o_checkForCompletion;
+    n_popResponseQueue;
+  }
+  transition(D_REQ_S, Ack) {
+    m_decrementNumberOfMessages;
+    o_checkForCompletion;
+    n_popResponseQueue;
+  }
+  transition(D_REQ_S, {Data, Exclusive_Data}, OM_AMO) {
+    u_writeDataToCache;
+    m_decrementNumberOfMessages;
+    o_checkForCompletion;
+    n_popResponseQueue;
+  }
+
+  transition({D_REQ, D_RETRY}, Inv) {
+    f_sendAck;
+    l_popForwardQueue;
+  }
+
+  transition({D_REQ, D_RETRY}, {Fwd_GETX, Fwd_GETS, Fwd_DMA}) {
+    f_sendAck;
+    l_popForwardQueue;
+  }
+
+
+
+
+  // ── ATOMIC_NO_RETURN (D-state foundation: functor apply after exclusive) ────
+  // Exclusive/writable: apply immediately via functor
+  transition({MM, M, M_W, MM_W}, {DStateReq_CPU, LocalAtomic_CPU}) {
+    d_amoComplete;
+    uu_profileDataHit;
+    k_popMandatoryQueue;
+  }
+
+  // Same binary/ordering contract; disable placement without a NACK round-trip.
+  transition(I, LocalAtomic_CPU, IM_AMO) {
+    ii_allocateL1DCacheBlock;
+    i_allocateTBE;
+    b_issueGETX;
+    uu_profileDataMiss;
+    k_popMandatoryQueue;
+  }
+
+  // I: delegate, but retain the CPU operation until application is acknowledged.
+  transition(I, DStateReq_CPU, D_REQ) {
+    ii_allocateL1DCacheBlock;
+    i_allocateTBE_dstate;
+    idsr_issueDStateReqFromL1;
+    uu_profileDataMiss;
+    k_popMandatoryQueue;
+  }
+
+  // S: upgrade to exclusive, then apply to the authoritative value.
+  transition(S, {DStateReq_CPU, LocalAtomic_CPU}, SM_AMO) {
+    i_allocateTBE;
+    b_issueGETX;
+    uu_profileDataMiss;
+    k_popMandatoryQueue;
+  }
+
+  // S with delegate_from_s: send the update to the home bank and give up the
+  // read copy. The block stays allocated only as the D_REQ placeholder and is
+  // freed on the terminal ACK; an Inv meanwhile is acknowledged from D_REQ (the
+  // home drains sharers before applying) and a NACK retries through GETX with a
+  // fresh fetch. Home-bank rejections make this a wasted round trip, so it is a
+  // knob, not the default.
+  transition(S, DStateReq_CPU_S, D_REQ_S) {
+    i_allocateTBE_dstate;
+    idsr_issueDStateReqFromL1;
+    k_popMandatoryQueue;
+  }
+
+  // Delegated-sharer duties (mirror S): a forwarded read is served from the still
+  // valid copy -- the home holds no data in ILS and relies on this sharer -- and an
+  // Inv is acknowledged, after which the block is only the D_REQ placeholder. The
+  // home never applies while a sharer remains (it drains sharers first), so the
+  // data served here is current.
+  transition({D_REQ_S, D_RETRY_S}, Fwd_GETS) {
+    e_sendData;
+    l_popForwardQueue;
+  }
+  transition({D_REQ_S, D_RETRY_S}, Fwd_DMA) {
+    e_sendData;
+    ub_dmaUnblockL2Cache;
+    l_popForwardQueue;
+  }
+  transition({D_REQ_S, D_RETRY_S}, Fwd_GETX) {
+    f_sendAck;
+    l_popForwardQueue;
+  }
+  transition(D_REQ_S, Inv, D_REQ) {
+    f_sendAck;
+    forward_eviction_to_cpu;
+    l_popForwardQueue;
+  }
+  transition(D_RETRY_S, Inv, D_RETRY) {
+    f_sendAck;
+    forward_eviction_to_cpu;
+    l_popForwardQueue;
+  }
+  transition(D_REQ_S, DState_ACK, I) {
+    d_checkResponseId;
+    camo_completeDelegated;
+    kk_deallocateL1CacheBlock;
+    s_deallocateTBE;
+    n_popResponseQueue;
+  }
+  transition(D_REQ_S, DState_NACK, D_RETRY_S) {
+    d_checkResponseId;
+    d_scheduleFallback;
+    n_popResponseQueue;
+  }
+  // Still a sharer: the fallback is an upgrade (acks only, data already held), the
+  // same path S takes for a conventional no-return atomic.
+  transition(D_RETRY_S, DState_Retry, SM_AMO) {
+    b_issueDStateFallbackGETX;
+    d_cancelFallbackTimer;
+  }
+
+  // O: upgrade to exclusive, then apply
+  transition(O, {DStateReq_CPU, LocalAtomic_CPU}, OM_AMO) {
+    i_allocateTBE;
+    b_issueGETX;
+    uu_profileDataMiss;
+    k_popMandatoryQueue;
+  }
+
+  // Stall a new AMO / store / load while an AMO upgrade is in flight, or during
+  // any other transient (CPU retries; state will resolve).
+  transition({IM_AMO, SM_AMO, OM_AMO}, {Store, Load, Ifetch, L1_Replacement, DStateReq_CPU, LocalAtomic_CPU}) {
+    zz_recycleMandatoryQueue;
+  }
+  transition({IM, SM, OM, IS, SI, OI, MI, II, D_REQ, D_RETRY, D_REQ_S, D_RETRY_S}, {DStateReq_CPU, LocalAtomic_CPU}) {
+    zz_recycleMandatoryQueue;
+  }
+  transition({D_REQ, D_RETRY, D_REQ_S, D_RETRY_S}, Store) {
+    // Plain store to a line with a delegated op still in flight: stall until
+    // D_REQ resolves to I, then re-issue as a normal write miss.
+    zz_recycleMandatoryQueue;
+  }
+  transition({D_REQ, D_RETRY, D_REQ_S, D_RETRY_S}, L1_Replacement) {
+    // The placeholder and TBE must survive until the operation completes.
+    zz_recycleMandatoryQueue;
+  }
+
+  // IM_AMO: collect acks/data (mirror IM), then apply on all_acks
+  transition(IM_AMO, Inv) {
+    f_sendAck;
+    l_popForwardQueue;
+  }
+  transition(IM_AMO, Ack) {
+    m_decrementNumberOfMessages;
+    o_checkForCompletion;
+    n_popResponseQueue;
+  }
+  transition(IM_AMO, {Exclusive_Data, Data}, OM_AMO) {
+    u_writeDataToCache;
+    m_decrementNumberOfMessages;
+    o_checkForCompletion;
+    n_popResponseQueue;
+  }
+
+  // SM_AMO: like SM but WRITE authoritative data on arrival (needed for correct add)
+  transition(SM_AMO, Inv, IM_AMO) {
+    f_sendAck;
+    forward_eviction_to_cpu;
+    l_popForwardQueue;
+  }
+  transition(SM_AMO, Ack) {
+    m_decrementNumberOfMessages;
+    o_checkForCompletion;
+    n_popResponseQueue;
+  }
+  transition(SM_AMO, {Data, Exclusive_Data}, OM_AMO) {
+    u_writeDataToCache;
+    m_decrementNumberOfMessages;
+    o_checkForCompletion;
+    n_popResponseQueue;
+  }
+  transition(SM_AMO, Fwd_GETS) {
+    e_sendData;
+    l_popForwardQueue;
+  }
+
+  // OM_AMO: have exclusive data; apply functor on all_acks
+  transition(OM_AMO, Own_GETX) {
+    mm_decrementNumberOfMessages;
+    o_checkForCompletion;
+    l_popForwardQueue;
+  }
+  transition(OM_AMO, Fwd_GETX, IM_AMO) {
+    ee_sendDataExclusive;
+    forward_eviction_to_cpu;
+    l_popForwardQueue;
+  }
+  transition(OM_AMO, Fwd_GETS) {
+    e_sendData;
+    l_popForwardQueue;
+  }
+  transition(OM_AMO, Ack) {
+    m_decrementNumberOfMessages;
+    o_checkForCompletion;
+    n_popResponseQueue;
+  }
+  transition(OM_AMO, All_acks, MM_W) {
+    d_amoComplete;
+    gg_sendUnblockExclusive;
+    s_deallocateTBE;
+    o_scheduleUseTimeout;
+    j_popTriggerQueue;
+  }
+
+}
