diff --git a/src/mem/ruby/protocol/RubySlicc_Exports.sm b/src/mem/ruby/protocol/RubySlicc_Exports.sm
index 33c1b55..4131359 100644
--- a/src/mem/ruby/protocol/RubySlicc_Exports.sm
+++ b/src/mem/ruby/protocol/RubySlicc_Exports.sm
@@ -78,11 +78,14 @@ structure(WriteMask, external="yes", desc="...") {
 }
 
 structure(DataBlock, external = "yes", desc="..."){
+  int getBlockSize();
   void clear();
   void copyPartial(DataBlock, int, int);
   void copyPartial(DataBlock, WriteMask);
   void atomicPartial(DataBlock, WriteMask);
   void atomicPartial(DataBlock, WriteMask, bool);
+  void applyDStateAdd(DataBlock, int, int);
+  void applyDStateAddMasked(DataBlock, int, int);
   int numAtomicLogEntries();
   void clearAtomicLogEntries();
 }
@@ -290,6 +293,21 @@ enumeration(MachineType, desc="...", default="MachineType_NULL") {
 
 // MessageSizeType
 enumeration(MessageSizeType, desc="...") {
+  // Delegated-update payload budget (128 B lines, 48-bit PA, <=64 requesters):
+  //   line address 41b + word offset 5b + size 1b + op 2b + requester 6b + tag 8b
+  //   = 63b header; + 32b operand = 95b -> 16 B; + 64b operand = 127b -> 24 B.
+  //   The terminal response needs only tag 8b + requester 6b + status 2b -> 8 B;
+  //   the requester keys on the tag, so no address travels back.
