+  bool dstateWouldPromote(Entry ce, MachineID req) {
+    if (d_state_persistence == false || is_invalid(ce)) { return false; }
+    if (ce.DStateReqCount + 1 < d_state_hot_threshold) { return false; }
+    return ce.DStateMultipleRequesters ||
+           (ce.DStateSeenRequester && ce.DStateFirstRequester != req);
+  }
