+  DState_UpdateW8,  desc="48-byte delta update: header + up to 8 word slots";
+  DState_UpdateW16, desc="80-byte delta update: header + up to 16 word slots";
+  DState_UpdateW32, desc="144-byte delta update: header + a full 128-byte delta line";
+  DState_Response, desc="8-byte terminal ACK/NACK: tag, requester, status";
+  DState_ResponseData, desc="16-byte terminal ACK carrying the updated 8-byte word";
   Control,    desc="Control Message";
