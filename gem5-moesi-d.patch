+void
+Sequencer::recordSpeculation(Addr line, const std::list<SequencerRequest> &requests, int count)
+{
+    // Predict the front add's word as the request will leave it: the copy this
+    // L1 holds plus every add to that word folded into this request. Wrong
+    // whenever another core's update reaches the home first, which is the
+    // measurement.
+    m_dstateSpec.erase(line);
+    if (!m_dataCache_ptr || !m_dataCache_ptr->isTagPresent(line))
+        return;
+    AbstractCacheEntry *entry = m_dataCache_ptr->lookup(line);
+    if (!entry)
+        return;
+    PacketPtr pkt = requests.front().pkt;
+    const int off = pkt->getAddr() - line, size = pkt->getSize();
+    DStateSpec spec;
+    spec.lo = pkt->getAddr();
+    spec.predicted.assign(entry->getDataBlk().getData(off, size),
+                          entry->getDataBlk().getData(off, size) + size);
+    int i = 0;
+    for (auto it = requests.begin(); it != requests.end() && i < count; ++it, ++i) {
+        if (it->pkt->isAtomicOp() && it->pkt->getAddr() == pkt->getAddr() &&
+            it->pkt->getSize() == size)
+            (*(it->pkt->getAtomicOp()))(spec.predicted.data());
+    }
+    m_dstateSpec[line] = std::move(spec);
+}
+
+void
+Sequencer::atomicRemoteCallback(Addr address, DataBlock &value, bool hasValue)
+{
+    // Completion only: the home controller already applied the operation.
+    // Calling hitCallback here would execute its functor a second time.
+    auto it = m_RequestTable.find(address);
+    panic_if(it == m_RequestTable.end() || it->second.empty(),
+             "Delegated atomic completed without an outstanding request");
+    auto &requests = it->second;
+    panic_if(m_usingRubyTester || m_ruby_system->getWarmupEnabled() ||
+             m_ruby_system->getCooldownEnabled(),
+             "MOESI-D remote completion requires the supported timing-CPU mode");
+    // One ACK completes every CPU request that the outstanding (possibly
+    // combined, see issueFront) request carried: the home applied their sum.
+    int count = 1;
+    auto cit = m_dstateCombined.find(address);
+    if (cit != m_dstateCombined.end()) {
+        count = cit->second;
+        m_dstateCombined.erase(cit);
+    }
+    panic_if(count < 1 || count > int(requests.size()),
+             "Combined no-return atomic covers more requests than are queued");
+    std::vector<PacketPtr> completed;
+    Addr word_lo = 0, word_hi = 0;
+    for (int i = 0; i < count; ++i) {
+        auto &request = requests.front();
+        panic_if(request.m_type != RubyRequestType_ATOMIC_NO_RETURN,
+                 "Remote completion is only valid for a no-return atomic");
+        if (i == 0) {
+            word_lo = request.pkt->getAddr();
+            word_hi = word_lo + request.pkt->getSize();
+            auto sp = m_dstateSpec.find(address);
+            if (hasValue) {
+                if (sp == m_dstateSpec.end() || sp->second.lo != word_lo) {
+                    m_dstateSpecNoCopy++;
+                } else if (std::equal(sp->second.predicted.begin(), sp->second.predicted.end(),
+                                      value.getData(word_lo - address, sp->second.predicted.size()))) {
+                    m_dstateSpecRight++;
+                } else {
+                    m_dstateSpecWrong++;
+                }
+            }
+            if (sp != m_dstateSpec.end()) m_dstateSpec.erase(sp);
+        }
+        recordMissLatency(&request, true, MachineType_NUM, true,
+                          Cycles(0), Cycles(0), Cycles(0));
+        markRemoved();
+        completed.push_back(request.pkt);
+        requests.pop_front();
+    }
+    llscClearMonitor(address);
+    // ACK-with-value: only the add's own word is carried (16 B response), so a
+    // load waiting behind the add is completed from it only when it lies within
+    // that word; anything else is issued as usual.
+    while (hasValue && !requests.empty() &&
+           requests.front().m_type == RubyRequestType_LD &&
+           requests.front().pkt->getAddr() >= word_lo &&
+           requests.front().pkt->getAddr() + requests.front().pkt->getSize() <= word_hi) {
+        auto &load = requests.front();
+        recordMissLatency(&load, true, MachineType_NUM, true,
+                          Cycles(0), Cycles(0), Cycles(0));
+        markRemoved();
+        hitCallback(&load, value, true, MachineType_NUM, true,
+                    Cycles(0), Cycles(0), Cycles(0), false);
+        requests.pop_front();
+    }
+    if (requests.empty()) {
+        m_RequestTable.erase(it);
+    } else {
+        issueFront(address, requests);
+    }
+    for (PacketPtr pkt : completed) {
+        ruby_hit_callback(pkt);
+    }
+    testDrainComplete();
+}
+
+void
+Sequencer::issueFront(Addr line, std::list<SequencerRequest> &requests)
+{
+    // MOESI-D requester-side combining. A CPU that may keep several no-return
+    // adds in flight (relaxed ordering, or an in-order store buffer) queues
+    // them here behind the one outstanding request to their line. When that
+    // request completes, the consecutive same-word adds at the front of the
+    // list are issued as ONE request whose operand is their modular sum; all
+    // of them complete on its ACK (atomicRemoteCallback). Only a consecutive
+    // run of the same type, address and width is combined, so ordering with
+    // respect to every other queued request is unchanged, and the request is
+    // still a single operand of the original width. If the L1 applies the
+    // request locally instead, atomicCallback applies the front request's own
+    // functor and re-issues the rest, so nothing is applied twice or lost.
+    assert(!requests.empty());
+    SequencerRequest &front = requests.front();
+    m_dstateCombined.erase(line);
+    if (m_dstateRequestCombine <= 1 ||
+        front.m_type != RubyRequestType_ATOMIC_NO_RETURN ||
+        !front.pkt->isAtomicOp()) {
+        if (front.m_type == RubyRequestType_ATOMIC_NO_RETURN && front.pkt->isAtomicOp())
+            recordSpeculation(line, requests, 1);
+        issueRequest(front.pkt, front.m_second_type);
+        return;
+    }
+    // Gather the consecutive run of no-return adds to this LINE, summing per
+    // word. Two widths claiming the same bytes end the run.
+    struct Word { int size; uint64_t sum; };
+    std::map<int, Word> words;
+    const int frontOff = getOffset(front.pkt->getAddr());
+    const int frontSize = front.pkt->getSize();
+    int count = 0, frontRun = 0;
+    bool frontRunOpen = true;
+    for (auto it = requests.begin();
+         it != requests.end() && count < m_dstateRequestCombine; ++it) {
+        if (it->m_type != RubyRequestType_ATOMIC_NO_RETURN || !it->pkt->isAtomicOp()) {
+            break;
+        }
+        const int off = getOffset(it->pkt->getAddr());
+        const int size = it->pkt->getSize();
+        auto *add32 = dynamic_cast<AtomicOpAdd<uint32_t> *>(it->pkt->getAtomicOp());
+        auto *add64 = dynamic_cast<AtomicOpAdd<uint64_t> *>(it->pkt->getAtomicOp());
+        if (!((size == 4 && add32) || (size == 8 && add64)) || off % size) {
+            break;
+        }
+        bool conflict = false;
+        for (const auto &w : words) {
+            if ((w.first != off || w.second.size != size) &&
+                w.first < off + size && off < w.first + w.second.size) {
+                conflict = true;
+            }
+        }
+        if (conflict) {
+            break;
+        }
+        Word &w = words[off];
+        w.size = size;
+        w.sum += size == 4 ? uint64_t(add32->a) : add64->a;
+        ++count;
+        if (frontRunOpen && off == frontOff && size == frontSize) {
+            ++frontRun;
+        } else {
+            frontRunOpen = false;
+        }
+    }
+    if (count <= 1) {
+        recordSpeculation(line, requests, 1);
+        issueRequest(front.pkt, front.m_second_type);
+        return;
+    }
+    DStateCombinedOp op;
+    auto wordMask = [](int off, int size, DStateCombinedOp &o) {
+        if (size == 8) o.mask64 |= 1u << (off / 8); else o.mask32 |= 1u << (off / 4);
+    };
+    if (words.size() == 1) {
+        // Same word throughout: one summed operand of the original width.
+        op.operand = words.begin()->second.sum;
+        if (frontSize == 4) op.operand &= 0xffffffffULL;
+        wordMask(frontOff, frontSize, op);
+        recordSpeculation(line, requests, count);
+        m_dstateCombined[line] = count;
+        issueRequest(front.pkt, front.m_second_type, &op);
+        return;
+    }
+    if (m_dstateDeltaMinWords > 0 && int(words.size()) >= m_dstateDeltaMinWords) {
+        // Delta line: every touched word's sum, in place, plus the word masks.
+        const int blk = m_ruby_system->getBlockSizeBytes();
+        op.line = true;
+        op.delta.assign(blk, 0);
+        for (const auto &w : words) {
+            uint64_t v = w.second.sum;
+            if (w.second.size == 4) v &= 0xffffffffULL;
+            for (int b = 0; b < w.second.size; ++b)
+                op.delta[w.first + b] = uint8_t(v >> (8 * b));
+            wordMask(w.first, w.second.size, op);
+        }
+        op.words = int(words.size());
+        recordSpeculation(line, requests, count);
+        m_dstateCombined[line] = count;
+        issueRequest(front.pkt, front.m_second_type, &op);
+        return;
+    }
+    // Otherwise combine only the front word's own consecutive run.
+    if (frontRun <= 1) {
+        recordSpeculation(line, requests, 1);
+        issueRequest(front.pkt, front.m_second_type);
+        return;
+    }
+    uint64_t sum = 0;
+    int n = 0;
+    for (auto it = requests.begin(); n < frontRun; ++it, ++n) {
+        auto *add32 = dynamic_cast<AtomicOpAdd<uint32_t> *>(it->pkt->getAtomicOp());
+        auto *add64 = dynamic_cast<AtomicOpAdd<uint64_t> *>(it->pkt->getAtomicOp());
+        sum += frontSize == 4 ? uint64_t(add32->a) : add64->a;
+    }
+    if (frontSize == 4) sum &= 0xffffffffULL;
+    op.operand = sum;
+    wordMask(frontOff, frontSize, op);
+    recordSpeculation(line, requests, frontRun);
+    m_dstateCombined[line] = frontRun;
+    issueRequest(front.pkt, front.m_second_type, &op);
+}
