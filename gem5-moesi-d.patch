+  DState_Update64, desc="24-byte 64-bit update: 63-bit header + 64-bit operand";
+  //   Delta-line updates carry several words of one line: 63-bit header + 32-bit
+  //   mask32 + 16-bit mask64 = 111b -> 14 B, plus 4 B per 32-bit word slot.
