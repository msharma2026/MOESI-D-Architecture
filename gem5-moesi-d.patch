+machine(MachineType:L2Cache, "Token protocol")
+: CacheMemory * L2cache;
+  Cycles response_latency := 1;
+  Cycles request_latency := 1;
+  // Defaults are copied verbatim into the generated Python SimObject, so bool
+  // defaults must be Python literals ("True"/"False"), not SLICC true/false.
+  bool d_state_enabled := "True";
+  bool d_state_persistence := "True";
+  bool d_state_force_nack := "False";
+  int d_state_hot_threshold := 4;
+  int d_state_read_downgrade_threshold := 3;
+  Cycles d_state_exec_latency := 42;
+  // Bank executor model. Defaults reproduce the conservative one-op, non-pipelined
+  // executor; the knobs are for the ablation, not a claimed datapath.
+  //   queue_depth   accepted operations in flight per bank (admission bound)
+  //   init_interval cycles between successive starts (== exec_latency: non-pipelined)
+  //   busy_stall    a request for a line already executing waits for it instead of
+  //                 being NACKed into the ordinary GETX path
+  int d_state_queue_depth := 1;
+  Cycles d_state_init_interval := 42;
+  bool d_state_busy_stall := "False";
+  // Back-pressure: when the executor is at capacity, park the request in the
+  // finite input buffer and wake it when a slot is released, instead of NACKing
+  // it into a full ownership migration. Default off (reject, as shipped).
+  bool d_state_queue_stall := "False";
+  // Far reads: a local load of a line held in D is answered with a snapshot of
+  // the data and NO sharer is recorded, so the next update needs no invalidation
+  // and the line never leaves the home. After read_downgrade_threshold reads
+  // with no intervening update the line is judged read-heavy and the next load
+  // takes the ordinary path (a cached copy). Default off.
+  bool d_state_far_reads := "False";
+  // A delegated request for a line the home does not hold, in a full set: evict
+  // a victim (as an L1 GETX does) instead of rejecting into a migration. Default
+  // off (reject, as shipped).
+  bool d_state_evict_for_delegate := "False";
+  // Epoch of updates after which the change-rate gate halves its counters.
+  int d_state_writer_epoch := 64;
+  // Change-rate gate: admit when the line's would-be ownership changes per
+  // hundred updates (GETX from a non-owner when conventional, update from a core
+  // other than the previous writer when delegated) reach d_state_min_change_pct
+  // and at least d_state_min_changes changes have been seen. The counters decay
+  // by halving every d_state_writer_epoch updates. 0 disables.
+  int d_state_min_change_pct := 0;
+  int d_state_min_changes := 2;
+  // Time-based decay of the gate table: a line idle for this many cycles
+  // restarts as single-writer (0: the update-count epoch resets the bitmap).
+  int d_state_writer_idle := 0;
+  // Lines the gate table tracks per bank (hardware-sized; see ARCHITECTURE 4a).
+  int d_state_gate_table := 1024;
+  // Serve a delegated update the admission gate refuses as the requester's GETX
+  // instead of a NACK: the line goes to the requester exclusive and it applies
+  // the retained operation on arrival, one trip instead of NACK + GETX. Only the
+  // gate's own decision ("the owner should have this line") is served this way;
+  // a line retained in D, a structural refusal (owned elsewhere mid-transition,
+  // executor or TBEs full, no L2 slot), a malformed request and forced-NACK
+  // testing all keep the NACK, because those refusals are transient and serving
+  // them would migrate a line the home is about to accept.
+  bool d_state_reject_as_getx := "False";
+  // Promote to D (retain the line) once the gate table shows this many would-be
+  // ownership changes for the line, instead of waiting for the update-count
+  // rule; far reads only engage on a retained line. 0: the update-count rule.
+  int d_state_promote_changes := 0;
+  // The terminal ACK carries the updated word (16 B response class) so the
+  // requester can complete a load of that word that is waiting behind the add.
+  bool d_state_ack_value := "False";
+  //   hit_latency   service time when the target word is in the bank's hot-word
+  //                 buffer (registers, not the SRAM array); default = full latency
+  //   hotwords      hot-word buffer entries per bank; 0 disables the model
+  //   merge_limit   same-word updates folded into one accepted operation
+  //                 (combining); 0 disables it
+  Cycles d_state_hit_latency := 42;
+  int d_state_hotwords := 0;
+  int d_state_merge_limit := 0;
+
+  // L2 BANK QUEUES
+  // From local bank of L2 cache TO the network
+  MessageBuffer * L1RequestFromL2Cache, network="To", virtual_network="0",
+        vnet_type="request";  // this L2 bank -> a local L1
