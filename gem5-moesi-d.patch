+
+  //*****************************************************
+
+  // Up to d_state_queue_depth accepted operations per L2 bank (one per line, since
+  // the TBE is per address); reserve the executor slot and TBE/cache slot before
+  // consuming the request. NACK is terminal non-acceptance, never a timeout or replay.
+  action(d_noteWriter, "dwriter", desc="Record a rejected delegated update in the gate table") {
+    peek(L1requestNetwork_in, RequestMsg) {
+      dStateEngine.noteAccess(address, machineIDToNodeID(in_msg.Requestor), curCycle(),
+                              d_state_writer_epoch, d_state_writer_idle, d_state_gate_table);
+    }
+  }
+  action(d_noteMigration, "dmigr", desc="Record a conventional ownership transfer in the gate table") {
+    peek(L1requestNetwork_in, RequestMsg) {
+      dStateEngine.noteAccess(address, machineIDToNodeID(in_msg.Requestor), curCycle(),
+                              d_state_writer_epoch, d_state_writer_idle, d_state_gate_table);
+    }
+  }
+  action(d_reject, "drej", desc="Reject before application") {
+    peek(L1requestNetwork_in, RequestMsg) {
+      enqueue(responseNetwork_out, ResponseMsg, response_latency) {
+        out_msg.addr := address;
+        out_msg.Type := CoherenceResponseType:DSTATE_NACK;
+        out_msg.Destination.add(in_msg.Requestor);
+        out_msg.Sender := machineID;
+        out_msg.SenderMachine := MachineType:L2Cache;
+        out_msg.DStateId := in_msg.DStateId;
+        out_msg.MessageSize := MessageSizeType:DState_Response;
+      }
+    }
+  }
+  action(d_save, "dsave", desc="Reserve the finite bank executor and retain the operation") {
+    assert(is_valid(tbe));
+    dStateEngine.reserve();
+    peek(L1requestNetwork_in, RequestMsg) {
+      tbe.DStateOperand := in_msg.DataBlk;
+      tbe.DStateOffset := in_msg.DStateOffset;
+      tbe.DStateSize := in_msg.Len;
+      tbe.DStateOrig := in_msg.Requestor;
+      tbe.DStateId := in_msg.DStateId;
+      tbe.DStateMerged.setMasks(in_msg.DStateMask32, in_msg.DStateMask64,
+                                in_msg.DStateOffset, in_msg.Len);
+      tbe.DStateHasOp := true;
+    }
+  }
+  action(d_merge, "dmerge", desc="Fold a same-word update into the pending accepted operation") {
+    assert(is_valid(tbe));
+    assert(tbe.DStateHasOp);
+    peek(L1requestNetwork_in, RequestMsg) {
+      // operand += incoming delta, word by word at each word's own width; the
+      // in_port admitted it only if no byte is claimed at two widths
+      assert(tbe.DStateMerged.masksCompatible(in_msg.DStateMask32, in_msg.DStateMask64));
+      if (in_msg.DStateMask32 == 0 && in_msg.DStateMask64 == 0) {
+        tbe.DStateOperand.applyDStateAdd(in_msg.DataBlk, in_msg.DStateOffset, in_msg.Len);
+        if (in_msg.Len == 8) {
+          tbe.DStateMerged.orMasks(0, 1 << (in_msg.DStateOffset / 8));
+        } else {
+          tbe.DStateMerged.orMasks(1 << (in_msg.DStateOffset / 4), 0);
+        }
+      } else {
+        tbe.DStateOperand.applyDStateAddMasked(in_msg.DataBlk, in_msg.DStateMask32, in_msg.DStateMask64);
+        tbe.DStateMerged.orMasks(in_msg.DStateMask32, in_msg.DStateMask64);
+      }
+      tbe.DStateMerged.add(in_msg.Requestor, in_msg.DStateId);
+      dStateEngine.noteAccess(address, machineIDToNodeID(in_msg.Requestor), curCycle(),
+                              d_state_writer_epoch, d_state_writer_idle, d_state_gate_table);
+    }
+  }
+  action(d_start, "dstart", desc="Charge service time; successive starts are spaced by the initiation interval") {
+    assert(is_valid(tbe));
+    assert(tbe.DStateHasOp);
+    assert(is_valid(cache_entry));
+    // With init_interval == exec_latency this is the original non-pipelined
+    // executor: the next operation starts only after this one finishes. A shorter
+    // interval models a pipelined datapath with exec_latency of latency.
+    Tick start := dStateEngine.scheduleStart(clockEdge(), cyclesToTicks(d_state_init_interval));
+    // Hot-word buffer: a word updated recently at this bank is modelled as
+    // register-resident and pays hit_latency instead of the SRAM service time.
+    Cycles service := d_state_exec_latency;
+    if (dStateEngine.hotWordHit(address, tbe.DStateOffset)) {
+      service := d_state_hit_latency;
+    }
+    dStateEngine.hotWordTouchMask(address, tbe.DStateMerged.mask32(), tbe.DStateMerged.mask64(),
+                                  d_state_hotwords);
+    dStateTimer.set(address, start + cyclesToTicks(service));
+  }
+  action(d_apply, "dapply", desc="Apply ADD once with unsigned 32/64-bit modular arithmetic") {
+    assert(is_valid(tbe));
+    assert(tbe.DStateHasOp);
+    assert(is_valid(cache_entry));
+    assert(cache_entry.Sharers.count() == 0);
+    assert(cache_entry.OwnerValid == false);
+    assert(dStateEngine.occupancy() > 0);
+    assert(dStateTimer.isSet(address));
+    cache_entry.DataBlk.applyDStateAddMasked(tbe.DStateOperand, tbe.DStateMerged.mask32(),
+                                             tbe.DStateMerged.mask64());
+    cache_entry.Dirty := true;
+    if (cache_entry.DStateSeenRequester == false) {
+      cache_entry.DStateFirstRequester := tbe.DStateOrig;
+      cache_entry.DStateSeenRequester := true;
+    } else if (cache_entry.DStateFirstRequester != tbe.DStateOrig) {
+      cache_entry.DStateMultipleRequesters := true;
+    }
+    // Each L1 holds at most one outstanding delegated update per line, so any
+    // merged requester is a different L1 from the original.
+    if (tbe.DStateMerged.count() > 0) {
+      cache_entry.DStateMultipleRequesters := true;
+    }
+    if (cache_entry.DStateReqCount < d_state_hot_threshold) {
+      cache_entry.DStateReqCount := cache_entry.DStateReqCount + 1;
+    }
+    dStateEngine.noteAccess(address, machineIDToNodeID(tbe.DStateOrig), curCycle(),
+                            d_state_writer_epoch, d_state_writer_idle, d_state_gate_table);
+    cache_entry.DStateReadRun := 0;
+    tbe.DStateHasOp := false;
+  }
+  action(d_ack, "dack", desc="Acknowledge after the authoritative value changed") {
+    assert(is_valid(tbe));
+    assert(tbe.DStateHasOp == false);
+    enqueue(responseNetwork_out, ResponseMsg, response_latency) {
+      out_msg.addr := address;
+      out_msg.Type := CoherenceResponseType:DSTATE_ACK;
+      out_msg.Destination.add(tbe.DStateOrig);
+      out_msg.Sender := machineID;
+      out_msg.SenderMachine := MachineType:L2Cache;
+      out_msg.DStateId := tbe.DStateId;
+      out_msg.MessageSize := MessageSizeType:DState_Response;
+      if (d_state_ack_value) {
+        // the updated word rides in the ACK: 8 B status + 8 B value, one flit
+        out_msg.DataBlk := cache_entry.DataBlk;
+        out_msg.HasValue := true;
+        out_msg.MessageSize := MessageSizeType:DState_ResponseData;
+      }
+    }
+  }
+  action(d_finish, "dfinish", desc="Release the executor after the ACK was queued") {
+    dStateTimer.unset(address);
+    dStateEngine.release();
+    if (d_state_queue_stall) {
+      // A slot is free: re-analyse requests parked by DState_Full (any line).
+      wakeUpAllBuffers();
+    }
+  }
+  action(d_unsetTimer, "dtimeroff", desc="Service complete; the merged-requester ACKs follow via the trigger queue") {
+    dStateTimer.unset(address);
+  }
+  action(d_releaseEngine, "drelease", desc="Release the executor after the last merged ACK was queued") {
+    dStateEngine.release();
+    if (d_state_queue_stall) {
+      // A slot is free: re-analyse requests parked by DState_Full (any line).
+      wakeUpAllBuffers();
+    }
+  }
+  action(d_ackNextMerged, "dackm", desc="Acknowledge one merged requester with its own transaction ID") {
+    assert(is_valid(tbe));
+    assert(tbe.DStateHasOp == false);
+    assert(tbe.DStateMerged.count() > 0);
+    enqueue(responseNetwork_out, ResponseMsg, response_latency) {
+      out_msg.addr := address;
+      out_msg.Type := CoherenceResponseType:DSTATE_ACK;
+      out_msg.Destination.add(tbe.DStateMerged.requester(tbe.DStateMerged.count() - 1));
+      out_msg.Sender := machineID;
+      out_msg.SenderMachine := MachineType:L2Cache;
+      out_msg.DStateId := tbe.DStateMerged.id(tbe.DStateMerged.count() - 1);
+      out_msg.MessageSize := MessageSizeType:DState_Response;
+      if (d_state_ack_value) {
+        out_msg.DataBlk := cache_entry.DataBlk;
+        out_msg.HasValue := true;
+        out_msg.MessageSize := MessageSizeType:DState_ResponseData;
+      }
+    }
+    tbe.DStateMerged.popBack();
+  }
+  action(d_scheduleAckMore, "dackmore", desc="Continue the merged-ACK loop on the trigger queue") {
+    enqueue(triggerQueue_out, TriggerMsg) {
+      out_msg.addr := address;
+      out_msg.Type := TriggerType:DSTATE_ACK_MORE;
+    }
+  }
+  action(d_recordRead, "dread", desc="Count only L2-visible coherence reads") {
+    assert(is_valid(cache_entry));
+    if (cache_entry.DStateReadRun < d_state_read_downgrade_threshold) {
+      cache_entry.DStateReadRun := cache_entry.DStateReadRun + 1;
+    }
+  }
+  action(d_keep, "dkeep", desc="Permit chip-local reacquisition after a D read") {
+    assert(is_valid(cache_entry));
+    cache_entry.DStateKeepAllowed := true;
+  }
+  action(d_getx, "dgetx", desc="Acquire global exclusive permission using the base directory") {
+    enqueue(globalRequestNetwork_out, RequestMsg, request_latency) {
+      out_msg.addr := address;
+      out_msg.Type := CoherenceRequestType:GETX;
+      out_msg.Requestor := machineID;
+      out_msg.RequestorMachine := MachineType:L2Cache;
+      out_msg.Destination.add(mapAddressToMachine(address, MachineType:Directory));
+      out_msg.MessageSize := MessageSizeType:Request_Control;
+    }
+  }
+  action(d_pull, "dpull", desc="Pull ONLY an exclusive local owner with no other readers") {
+    enqueue(localRequestNetwork_out, RequestMsg, response_latency) {
+      out_msg.addr := address;
+      out_msg.Type := CoherenceRequestType:GETX;
+      out_msg.Requestor := machineID;
+      out_msg.RequestorMachine := MachineType:L2Cache;
+      out_msg.Destination.add(getLocalOwner(cache_entry, address));
+      out_msg.MessageSize := MessageSizeType:Forwarded_Control;
+      out_msg.Acks := 0;
+    }
+  }
+  action(d_copyResponse, "dcopyr", desc="Install owner data in the reserved block") {
+    peek(responseNetwork_in, ResponseMsg) {
+      assert(is_valid(cache_entry));
+      cache_entry.DataBlk := in_msg.DataBlk;
+      cache_entry.Dirty := in_msg.Dirty;
+    }
+  }
+  action(d_copyTBE, "dcopyt", desc="Install acquired data in the reserved block") {
+    assert(is_valid(cache_entry));
+    assert(is_valid(tbe));
+    cache_entry.DataBlk := tbe.DataBlk;
+    cache_entry.Dirty := tbe.Dirty;
+  }
+
+  // TRANSITIONS
+  //*****************************************************
+
+  transition({II, IFGX, IFGS, ISFGS, IFGXX, IFGXXD, IFLXO, ILOW, ILOXW, ILOSW, ILOSXW, SLSW, OLSW, ILSW, IW, OW, SW, OXW, OLSXW, ILXW, IFLS, IFLO, IFLOX, IFLOXX, IFLOSX, OLSXS, IGS, IGM, IGMLS, IGMO, IGMOU, IGMIO, OGMIO, IGMIOF, IGMIOFD, OGMIOF, MM, SS, OO, OI, MI, MII, OLSI, ILSI, SLSS, OLSS, OLSF, IGMIOFS, ILOSD, ILOSXD, ILOD, ILXD, ILOXD}, {L1_PUTO, L1_PUTS, L1_PUTS_only, L1_PUTX}) {
+    st_stallAndWaitL1RequestQueue;
+  }
+
+  transition({II, IFGX, IFGS, ISFGS, IFGXX, IFGXXD, IFLXO, ILOW, ILOXW, ILOSW, ILOSXW, SLSW, OLSW, ILSW, IW, OW, SW, OXW, OLSXW, ILXW, IFLS, IFLO, IFLOX, IFLOXX, IFLOSX, OLSXS, IGS, IGM, IGMLS, IGMO, IGMOU, IGMIO, OGMIO, IGMIOF, IGMIOFD, OGMIOF, MM, SS, OO, OI, MI, MII, OLSI, ILSI, SLSS, OLSS, OLSF, IGMIOFS, ILOSD, ILOSXD, ILOD, ILXD, ILOXD}, {L1_GETX, L1_GETS}) {
+    st_stallAndWaitL1RequestQueue;
