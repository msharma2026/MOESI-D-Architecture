+  }
+  transition(D_EXEC_D, DState_Complete, D) {
+    d_apply; d_ack; d_finish; r_setMRU;
+    s_deallocateTBE; wa_wakeUpDependents;
+  }
+
+  // Combined operation: apply the summed operand once, ACK the original
+  // requester, then ACK each merged requester one per trigger-queue event. The
+  // executor slot is released only after the last ACK is queued; the line stays
+  // busy (requests park or reject) until then.
+  transition(D_EXEC_M, DState_CompleteMerged, D_ACKING_M) {
+    d_apply; d_ack; d_unsetTimer; d_scheduleAckMore;
+  }
+  transition(D_EXEC_D, DState_CompleteMerged, D_ACKING_D) {
+    d_apply; d_ack; d_unsetTimer; d_scheduleAckMore;
+  }
+  transition({D_ACKING_M, D_ACKING_D}, DState_AckMore) {
+    d_ackNextMerged; d_scheduleAckMore; n_popTriggerQueue;
+  }
+  transition(D_ACKING_M, DState_AckDone, M) {
+    d_releaseEngine; r_setMRU; s_deallocateTBE; wa_wakeUpDependents; n_popTriggerQueue;
+  }
+  transition(D_ACKING_D, DState_AckDone, D) {
+    d_releaseEngine; r_setMRU; s_deallocateTBE; wa_wakeUpDependents; n_popTriggerQueue;
+  }
+
+  // D is a local policy state. Use the ordinary global MOESI messages,
+  // including DMA, rather than maintaining a second directory D machine.
+  transition(D, Fwd_GETX, I) {
+    dd_sendDataToFwdGETX;
+    checkCacheNoSharersNoOwner;
+    rr_deallocateL2CacheBlock;
+    m_popRequestQueue;
+  }
+  transition(D, Fwd_GETS, I) {
+    dd_sendExclusiveDataToFwdGETS;
+    checkCacheNoSharersNoOwner;
+    rr_deallocateL2CacheBlock;
+    m_popRequestQueue;
+  }
+  transition(D, Fwd_DMA) {
+    dd_sendExclusiveDataToFwdGETS;
+    da_sendDmaAckUnblock;
+    m_popRequestQueue;
+  }
+  transition(D, L1_GETX, MM) {
+    d_noteMigration;
+    i_allocateTBE;
+    h_countLocalSharersExceptRequestor;
+    d_sendDataToL1GETX;
+    y_copyCacheStateToDir;
+    rr_deallocateL2CacheBlock;
+    s_deallocateTBE;
+    uu_profileHit;
+    o_popL1RequestQueue;
+  }
+  transition(D, L1_GETS, OLSXS) {
+    d_sendDataToL1GETS;
+    d_keep;
+    d_recordRead;
+    r_setMRU;
+    uu_profileHit;
+    o_popL1RequestQueue;
+  }
+  // Far read: the line stays retained at the home with no sharer. The next
+  // update therefore applies with no invalidation. A read run that reaches the
+  // downgrade threshold (no update in between) routes to L1_GETS above instead.
+  transition(D, L1_GETS_Far, D) {
+    d_sendSnapshotToL1GETS;
+    d_recordRead;
+    r_setMRU;
+    uu_profileHit;
+    o_popL1RequestQueue;
+  }
+  transition(D, L2_Replacement, MI) {
+    b_issuePUTX;
+    i_allocateTBE;
+    rr_deallocateL2CacheBlock;
+  }
+
+  transition({IGDX, IGDXO, IGD_P, DX_DRAIN, D_EXEC_M, D_EXEC_D, D_ACKING_M, D_ACKING_D},
+             {L1_GETS, L1_GETX, L1_PUTO, L1_PUTS, L1_PUTS_only, L1_PUTX, L2_Replacement}) {
+    zz_recycleL1RequestQueue;
+  }
+  transition({IGDX, IGDXO, IGD_P, DX_DRAIN, D_EXEC_M, D_EXEC_D, D_ACKING_M, D_ACKING_D},
+             {Fwd_GETX, Fwd_GETS, Fwd_DMA}) {
+    zz_recycleGlobalRequestQueue;
+  }
+  transition({IGD_P, DX_DRAIN, D_EXEC_M, D_EXEC_D, D_ACKING_M, D_ACKING_D}, Inv) {
+    zz_recycleGlobalRequestQueue;
+  }
+
+}
