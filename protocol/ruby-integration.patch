+void
+Sequencer::atomicRemoteCallback(Addr address)
+{
+    // Completion only: the home controller already applied the operation.
+    // Calling hitCallback here would execute its functor a second time.
+    auto it = m_RequestTable.find(address);
+    panic_if(it == m_RequestTable.end() || it->second.empty(),
+             "Delegated atomic completed without an outstanding request");
+    auto &requests = it->second;
+    auto &request = requests.front();
+    panic_if(request.m_type != RubyRequestType_ATOMIC_NO_RETURN,
+             "Remote completion is only valid for a no-return atomic");
+    panic_if(m_usingRubyTester || m_ruby_system->getWarmupEnabled() ||
+             m_ruby_system->getCooldownEnabled(),
+             "MOESI-D remote completion requires the supported timing-CPU mode");
+    PacketPtr pkt = request.pkt;
+    recordMissLatency(&request, true, MachineType_NUM, true,
+                      Cycles(0), Cycles(0), Cycles(0));
+    llscClearMonitor(address);
+    markRemoved();
+    requests.pop_front();
+    if (requests.empty()) {
+        m_RequestTable.erase(it);
+    } else {
+        issueRequest(requests.front().pkt, requests.front().m_second_type);
+    }
+    ruby_hit_callback(pkt);
+    testDrainComplete();
+}
