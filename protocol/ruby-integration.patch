+inline void
+DataBlock::applyDStateAdd(const DataBlock &operand, int offset, int size)
+{
+    assert(m_alloc && operand.m_alloc);
+    assert((size == 4 || size == 8) && offset >= 0 && offset % size == 0);
+    assert(offset + size <= m_block_size && offset + size <= operand.m_block_size);
+    // Explicit little-endian transport and unsigned modular arithmetic avoid
+    // host alignment, byte-order and signed-overflow dependencies.
+    dstateAdd(m_data, operand.m_data, m_block_size, offset, size);
+}
+
+inline void
+DataBlock::applyDStateAddMasked(const DataBlock &operand, int mask32, int mask64)
+{
+    assert(m_alloc && operand.m_alloc);
+    assert(m_block_size >= 128 && operand.m_block_size == m_block_size);
+    dstateAddMasked(m_data, operand.m_data, m_block_size,
+                    std::uint32_t(mask32), std::uint32_t(mask64));
+}
