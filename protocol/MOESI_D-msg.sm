// DStateOpType - mini-ALU operation codes for D-state reductions
enumeration(DStateOpType, desc="Implemented modular integer reductions") {
  IADD32, desc="32-bit modular add";
  IADD64, desc="64-bit modular add";
}

// Per-bank executor model (src/mem/ruby/structures/DStateEngine.hh): bounded
// admission plus an initiation interval between successive starts.
structure(DStateEngine, external="yes") {
  bool hasCapacity(int);
  int occupancy();
  void reserve();
  void release();
  Tick scheduleStart(Tick, Tick);
  bool hotWordHit(Addr, int);
  void hotWordTouch(Addr, int, int);
  void hotWordDrop(Addr);
  uint64_t nextId();
}

// Requesters merged into an already-accepted same-word update; each gets its
// own terminal ACK (see the DState_AckMore loop in the L2 controller).
structure(DStateMergeSet, external="yes") {
  void add(MachineID, uint64_t);
  int count();
  MachineID requester(int);
  uint64_t id(int);
  void popBack();
  void clear();
}

// CoherenceRequestType
enumeration(CoherenceRequestType, desc="...") {
  GETX,      desc="Get eXclusive";
  GETS,      desc="Get Shared";
  PUTX,      desc="Put eXclusive";
  PUTO,      desc="Put Owned";
  PUTO_SHARERS,      desc="Put Owned, but sharers exist so don't remove from sharers list";
  PUTS,      desc="Put Shared";
  INV,       desc="Invalidation";
  WRITEBACK_CLEAN_DATA,   desc="Clean writeback (contains data)";
  WRITEBACK_CLEAN_ACK,    desc="Clean writeback (contains no data)";
  WRITEBACK_DIRTY_DATA,   desc="Dirty writeback (contains data)";
  DSTATE_REQ, desc="No-return update request from L1 to home L2";
  DMA_READ,  desc="DMA Read";
  DMA_WRITE, desc="DMA Write";
}

// CoherenceResponseType
enumeration(CoherenceResponseType, desc="...") {
  ACK,               desc="ACKnowledgment, responder doesn't have a copy";
  DATA,              desc="Data";
  DATA_EXCLUSIVE,    desc="Data, no processor has a copy";
  UNBLOCK,           desc="Unblock";
  UNBLOCK_EXCLUSIVE, desc="Unblock, we're in E/M";
  WB_ACK,            desc="Writeback ack";
  WB_ACK_DATA,       desc="Writeback ack";
  WB_NACK,           desc="Writeback neg. ack";
  DSTATE_ACK,       desc="D-state op applied and globally ordered (vnet2)";
  DSTATE_NACK,      desc="D-state op rejected, fallback GETX (vnet2)";
  DMA_ACK,           desc="Ack that a DMA write completed";
}

// TriggerType
enumeration(TriggerType, desc="...") {
  ALL_ACKS,            desc="See corresponding event";
  DSTATE_ACK_MORE,     desc="Acknowledge the next merged requester (or finish if none remain)";
}

// TriggerMsg
structure(TriggerMsg, desc="...", interface="Message") {
  Addr addr,             desc="Physical address for this request";
  TriggerType Type,            desc="Type of trigger";

  bool functionalRead(Packet *pkt) {
    // Trigger message does not hold data
    return false;
  }

  bool functionalWrite(Packet *pkt) {
    // Trigger message does not hold data
    return false;
  }
}

// RequestMsg (and also forwarded requests)
structure(RequestMsg, desc="...", interface="Message") {
  Addr addr,             desc="Physical address for this request";
  int Len,                     desc="Length of Request";
  CoherenceRequestType Type,   desc="Type of request (GetS, GetX, PutX, etc)";
  MachineID Requestor,            desc="Node who initiated the request";
  MachineType RequestorMachine,   desc="type of component";
  NetDest Destination,             desc="Multicast destination mask";
  DataBlock DataBlk,           desc="data for the cache line (DMA WRITE request)";
  int Acks,                    desc="How many acks to expect";
  MessageSizeType MessageSize, desc="size category of the message";
  RubyAccessMode AccessMode,    desc="user/supervisor access type";
  PrefetchBit Prefetch,         desc="Is this a prefetch request";
  DStateOpType DStateOp,    desc="Mini-ALU op code (DSTATE_REQ only)";
  int DStateOffset,         desc="Word offset within cache line for op";
  uint64_t DStateId, default="0", desc="Per-requester transaction ID; echoed by ACK/NACK";


  bool functionalRead(Packet *pkt) {
    // Read only those messages that contain the data
    if (Type == CoherenceRequestType:WRITEBACK_CLEAN_DATA ||
        Type == CoherenceRequestType:WRITEBACK_DIRTY_DATA) {
        return testAndRead(addr, DataBlk, pkt);
    }
    return false;
  }

  bool functionalWrite(Packet *pkt) {
    // An update payload is an operand, not a cached value. Never overwrite it
    // with a functional/debugger write to the target address.
    if (Type == CoherenceRequestType:DSTATE_REQ) { return false; }
    return testAndWrite(addr, DataBlk, pkt);
  }
}

// ResponseMsg (and also unblock requests)
structure(ResponseMsg, desc="...", interface="Message") {
  Addr addr,             desc="Physical address for this request";
  CoherenceResponseType Type,  desc="Type of response (Ack, Data, etc)";
  MachineID Sender,               desc="Node who sent the data";
  MachineType SenderMachine,   desc="type of component sending msg";
  NetDest Destination,             desc="Node to whom the data is sent";
  DataBlock DataBlk,           desc="data for the cache line";
  bool Dirty,                  desc="Is the data dirty (different than memory)?";
  int Acks,                    desc="How many acks to expect";
  MessageSizeType MessageSize, desc="size category of the message";
  uint64_t DStateId, default="0", desc="Correlates terminal delegated completion/rejection";

  bool functionalRead(Packet *pkt) {
    // Read only those messages that contain the data
    if (Type == CoherenceResponseType:DATA ||
        Type == CoherenceResponseType:DATA_EXCLUSIVE) {
        return testAndRead(addr, DataBlk, pkt);
    }
    return false;
  }

  bool functionalWrite(Packet *pkt) {
    // No check required since all messages are written
    return testAndWrite(addr, DataBlk, pkt);
  }
}
