 """
+
+# Experimental no-return ADD subset using the AADD encoding. Unfenced: the
+# store-class micro-op is ordered as a store under TSO (older accesses complete
+# before it is sent; younger stores wait for its acknowledgement), so no mfence
+# is needed for store ordering. Software adds fences where load-after-add
+# ordering is required, as after any store (bench/dstate_ops.h DSTATE_FENCED).
+# No CPUID RAO-INT advertisement; see docs/ARCHITECTURE.md.
+# Standard ADD_LOCKED macros above are intentionally unchanged.
+microcode += """
+def macroop AADD_M_R {
+    stula reg, seg, sib, disp
+};
+def macroop AADD_P_R {
+    rdip t7
+    stula reg, seg, riprel, disp
+};
+"""
